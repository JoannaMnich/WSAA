div[ng-grid] {
font-size: 14px !important;
//margin-top: -20px;
}

.pb-htable { 
padding:0px; 
margin:0px;
} 



 th
{
  background-color: #D9D9D6;
}

textarea.pb-detail.pb-textArea, textarea.pb-item.pb-textArea{
	width: 70%;
	height: 10em;
	border: 3px solid #cccccc;
	padding: 5px;
       font-family: monospace;
        resize: vertical;
}

input.pb-item.pb-text,
input.pb-item.pb-number,
input.pb-item.pb-datetime,
input.pb-item.pb-email,
input.pb-item.pb-tel,
input.pb-item.pb-boolean,
input.pb-item.pb-radio,
select.pb-item.pb-select
{
  border-radius: 2px;
  margin: 6px 50px;
  border: 1px solid #869FB1;
  font-size: 14px;
  padding: 3px;
  box-sizing: border-box;
  webkit-box-sizing: border-box;
  background-color: #FFFFFF;
  display:inline-block;
 }
 input.pb-item:focus {
        border: 1px solid #206E9F;
        box-shadow: inset 0px 2px 2px #CBE2E8;
        color: #4F585F;
 }
input.pb-item.hasDatepicker{
  height:inherit;
}

.textWidthWide {
      width: 300px; 
}

.textWidthNarrow {
      width: 180px;  
}

.displayBold {
      font-weight: bold;
}

label.pb-label,
label.pb-label.pb-boolean{
  width:14em; 
  text-align:left;
  display:inline-block;
  margin: 0px 0px 0px 20px;
}

select.pb-select:focus {
  background-color: #FFFFFF;
  border: 1px solid #206E9F; }

.inlineRow{
   display:inline-block;
}

//Classlist
.on-top {
    z-index: 1000;
}

.modal-mask {
    position: fixed;
     top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: #000;
    opacity: 0.25;
    
    transition: all ease 1s;
}

.modal-buttonx{
    width: 100%;
    height: 100%;
	opacity: 0;
}


.pad-small {
    padding: 0.5em !important;
}

.transparent{
   opacity: 0;
}

.xe-modal-container {
    height: auto;
    padding: 1.5em;
    border-radius: 6px;
    box-shadow: 0 2px 40px rgba(0, 0, 0, 0.5);
    position: fixed;
    top: 80px;
}

.lg-modal {
    width: 1000px;
    transform: translate(25%, 0%);
}

.email-textarea {
   width: 100%;
}